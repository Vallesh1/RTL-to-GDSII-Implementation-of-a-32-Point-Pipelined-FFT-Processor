set_design_attributes -elements . -internal_attribute _mv_data_file_version 1
set_design_attributes -elements . -attribute \
    enable_state_propagation_in_add_power_state false

## Start - load_upf /home1/IITR_PD3/MulukuriVNath/Documents/RTL-to-GDSII-Implementation-of-a-32-Point-Pipelined-FFT-Processor/PnR/scripts/FFT.upf on Mon Oct  5 17:41:57 2026
upf_version 2.0

# 1. Create Top-Level Power Domain
create_power_domain TOP -include_scope

# 2. Create Supply Ports
create_supply_port VDD
create_supply_port VSS

# 3. Create Supply Nets (REMOVED '-domain TOP' to make them domain-independent)
create_supply_net VDD
create_supply_net VSS

# 4. Connect Ports to Nets
connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS

# 5. Create Supply Set (Will now succeed without UPF-180)
create_supply_set SS_DEFAULT  \
    -function {power VDD}  \
    -function {ground VSS}

# 6. Bind Supply Nets to Domain
set_domain_supply_net TOP -primary_power_net VDD -primary_ground_net VSS

# 7. Define Unified Power State
add_power_state SS_DEFAULT -state ON { -supply_expr {power == {FULL_ON 0.6} && ground == {FULL_ON 0.0}} }

# 8. Disable Isolation
set_isolation ISO_DISABLE -domain TOP -applies_to outputs -no_isolation
## End - load_upf /home1/IITR_PD3/MulukuriVNath/Documents/RTL-to-GDSII-Implementation-of-a-32-Point-Pipelined-FFT-Processor/PnR/scripts/FFT.upf

## Constraints below are generated by snps. Please do not modify.
set derived_upf true

if ($derived_upf) {

set_design_attributes -elements . -internal_attribute _mv_data_status ready
set_design_attributes -elements . -internal_attribute _ldi_supply_sets \
    {SS_DEFAULT} -internal_attribute _ldi_supply_nets {VDD VSS} \
    -internal_attribute _ldi_domains {{TOP+VDD+VSS}}
set_design_attributes -elements . -internal_attribute \
    _disallow_fwd_biasing_domains { TOP+true }
set_design_attributes -elements . -internal_attribute \
    _disallow_rvs_biasing_domains { TOP+true }

}
set derived_upf false
