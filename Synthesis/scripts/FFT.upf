# ============================================================================
# GOLDEN UPF - 32-POINT PIPELINED FFT PROCESSOR
# ============================================================================
# Design      : FFT (5-stage R2SDF Pipeline)
# Technology  : 14nm Standard Cell (Single Voltage Domain)
# Tool        : Synopsys Design Compiler (IEEE 1801-2013)
# ============================================================================

# 1. POWER DOMAIN DEFINITION
# ============================================================================
# Create the top-level power domain. -include_scope ensures that all
# submodules (radix2, shift_*, ROM_*) inherit this domain.
create_power_domain TOP -include_scope

# 2. SUPPLY PORTS (CHIP BOUNDARY)
# ============================================================================
# Declare the physical power and ground ports of the top-level module.
create_supply_port VDD
create_supply_port VSS

# 3. SUPPLY NETS (INTERNAL LOGICAL NETS)
# ============================================================================
# Create the internal supply rails. No -domain or -reuse flags are needed
# as DC creates them in the current scope (TOP) by default.
create_supply_net VDD
create_supply_net VSS

# 4. CONNECT SUPPLY NETS TO PORTS
# ============================================================================
# Physically connect the internal rails to the top-level ports.
connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS

# 5. ASSIGN PRIMARY POWER/GROUND TO THE DOMAIN
# ============================================================================
# This is the essential command that binds the supply nets to the domain
# for all timing and power analysis during synthesis.
set_domain_supply_net TOP -primary_power_net VDD -primary_ground_net VSS

# 6. SUPPLY SET DEFINITION (BUNDLED VOLTAGE GROUP)
# ============================================================================
# A supply set bundles the power and ground nets into a single named object.
# This is a standard practice for formal verification and UPF-based flows,
# ensuring that the tool recognizes VDD/VSS as a paired power source.
create_supply_set SS_DEFAULT
set_supply_set -power VDD -ground VSS SS_DEFAULT

# 7. POWER STATE TABLE (PST) FOR FORMAL VERIFICATION
# ============================================================================
# Defines the voltage values for the supply net. While DC ignores PST during
# synthesis, it is required for downstream formal MV verification (MV-SIM)
# and for complete UPF compliance.
add_power_state VDD -state ALWAYS_ON -logic_expr 1 -voltage 0.6
add_power_state VSS -state ALWAYS_ON -logic_expr 0 -voltage 0.0

# 8. ISOLATION POLICY OVERRIDE
# ============================================================================
# Since this is a single-domain (always-on) design, no isolation cells are
# required. This explicit override prevents the tool from attempting to
# map isolation cells if the library contains them, which would cause
# unnecessary area and routing overhead.
set_isolation ISO_DISABLE -domain TOP -applies_to outputs -no_isolation

# ============================================================================
# END OF GOLDEN UPF
# ============================================================================